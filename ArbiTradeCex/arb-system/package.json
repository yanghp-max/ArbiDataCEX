{
  "name": "arbitradecex",
  "version": "0.1.0",
  "description": "CEX-CEX arbitrage (Binance PM + Gate unified)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dry": "npm run build:dashboard && node strategies/cex-cex-multi-strategy.js --dry",
    "live": "npm run build:dashboard && node strategies/cex-cex-multi-strategy.js --live",
    "start": "npm run dry",
    "build:dashboard": "npm install --prefix dashboard/frontend && npm run build --prefix dashboard/frontend",
    "dev:dashboard": "npm run dev --prefix dashboard/frontend",
    "fetch:min-qty": "node scripts/fetch-min-order-qty.js",
    "build:symbols-min-qty": "node scripts/build-common-min-order-qty.js",
    "build:symbols-min-qty:pair": "node scripts/build-common-min-order-qty.js --provider-a binance --provider-b gate",
    "build:symbols-min-qty:binance-aster": "node scripts/build-common-min-order-qty.js --provider-a binance --provider-b aster",
    "build:symbols-min-qty:binance-bybit": "node scripts/build-common-min-order-qty.js --provider-a binance --provider-b bybit",
    "build:symbols-min-qty:binance-bitget": "node scripts/build-common-min-order-qty.js --provider-a binance --provider-b bitget",
    "build:symbols-min-qty:binance-hyperliquid": "node scripts/build-common-min-order-qty.js --provider-a binance --provider-b hyperliquid"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.9",
    "big.js": "^6.2.2",
    "dotenv": "^16.4.7",
    "ethers": "^6.16.0",
    "ws": "^8.18.0"
  }
}
